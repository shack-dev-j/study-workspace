#!/usr/bin/env python3
"""Study Workspace launcher: opens the app in its own window.

install.sh / PKGBUILD replace @APP_DIR@ with the installed app folder.
Run from the repo, it uses the repo folder (portable mode).
"""
import os
import sys

APP_DIR = os.environ.get("STUDY_WORKSPACE_APP") or "@APP_DIR@"
if APP_DIR.startswith("@"):
    APP_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, APP_DIR)

from backend.launcher import main  # noqa: E402

sys.exit(main())
